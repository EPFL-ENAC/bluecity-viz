{
  "_comment": "Template for <worktree>/.claude/settings.local.json, written by scripts/wt-setup.sh (it fills __RESSLAB_DATA_DIR__). Claude runs in auto mode here: the classifier judges everything not listed. deny = never; ask = always prompt, even in auto mode; allow = skip the classifier for these routine commands. curl is excluded from the sandbox because the Linux sandbox cannot reach loopback (the worktree's own dev servers) — excluded commands go through the classifier and the ask rules instead. Rationale in docs/worktree-dev-environment.md.",
  "permissions": {
    "additionalDirectories": [
      "__RESSLAB_DATA_DIR__"
    ],
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make api)",
      "Bash(uv run pytest *)",
      "Bash(npm run type-check)",
      "Bash(npm run lint)",
      "Bash(npm run test:unit *)",
      "Bash(curl http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -sS http://localhost:*)",
      "Bash(curl -sS http://127.0.0.1:*)",
      "Bash(curl -fsS http://localhost:*)",
      "Bash(curl -fsS http://127.0.0.1:*)",
      "Bash(curl -i http://localhost:*)",
      "Bash(curl -i http://127.0.0.1:*)",
      "Bash(curl -I http://localhost:*)",
      "Bash(curl -I http://127.0.0.1:*)"
    ],
    "ask": [
      "Bash(curl * -X *)",
      "Bash(curl *-X*)",
      "Bash(curl * --request *)",
      "Bash(curl * -d *)",
      "Bash(curl * --data*)",
      "Bash(curl * -F *)",
      "Bash(curl * --form*)",
      "Bash(curl * -T *)",
      "Bash(curl * --upload-file *)",
      "Bash(curl * --json *)",
      "Bash(wget * --post*)",
      "Bash(wget * --method*)",
      "Bash(http POST *)",
      "Bash(http PUT *)",
      "Bash(http PATCH *)",
      "Bash(http DELETE *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api * --input *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(sh)",
      "Bash(bash)",
      "Bash(zsh)",
      "Bash(sh -s*)",
      "Bash(bash -s*)",
      "Bash(python -)",
      "Bash(python3 -)",
      "Bash(node -)",
      "Bash(perl -)",
      "Bash(bash <(*))",
      "Bash(sh <(*))",
      "Bash(source <(*))",
      "Bash(* $(curl *))",
      "Bash(* $(wget *))",
      "Bash(eval *)",
      "Bash(npx -y *)",
      "Bash(npx --yes *)",
      "Bash(uvx *)",
      "Bash(pipx run *)",
      "Bash(pip install http*)",
      "Bash(pip install git+*)",
      "Bash(uv add git+*)",
      "Bash(chmod +x *)",
      "Bash(chmod * +x *)",
      "Bash(dangerouslyDisableSandbox:true)"
    ],
    "deny": [
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * dev)",
      "Bash(git push * stage)",
      "Bash(git push * main)",
      "Bash(git push *:dev)",
      "Bash(git push *:stage)",
      "Bash(git push *:main)",
      "Bash(git remote set-url *)",
      "Bash(git remote add *)",
      "Bash(claude *)",
      "mcp__claude_ai_Google_Calendar__create_event",
      "mcp__claude_ai_Google_Calendar__update_event",
      "mcp__claude_ai_Google_Calendar__delete_event",
      "mcp__claude_ai_Google_Calendar__respond_to_event",
      "mcp__claude_ai_Google_Drive__create_file",
      "mcp__claude_ai_Google_Drive__update_file",
      "mcp__claude_ai_Google_Drive__trash_file",
      "mcp__claude_ai_Google_Drive__share_file",
      "mcp__claude_ai_Google_Drive__copy_file",
      "mcp__notion__API-post-*",
      "mcp__notion__API-patch-*",
      "mcp__notion__API-delete-*",
      "mcp__notion__API-create-*",
      "mcp__notion__API-update-*",
      "mcp__notion__API-move-page",
      "mcp__plugin_figma_*"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "docker *",
      "curl *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "mcp.context7.com"
      ]
    }
  }
}
