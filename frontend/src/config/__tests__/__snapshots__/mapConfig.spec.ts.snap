  {
    "id": "vehicle_tracks",
    "info": "Vehicle tracking data showing routes taken by vehicles on different dates",
    "label": "Vehicle Tracking Routes",
    "layer": {
      "id": "vehicle_tracks-layer",
      "paint": {
        "line-color": [
          "interpolate-hcl",
          [
            "linear",
          ],
          [
            "%",
            [
              "+",
              [
                "length",
                [
                  "get",
                  "vehicle_id",
                ],
              ],
              [
                "+",
                [
                  "to-number",
                  [
                    "slice",
                    [
                      "get",
                      "vehicle_id",
                    ],
                    0,
                    2,
                  ],
                  16,
                ],
                [
                  "to-number",
                  [
                    "slice",
                    [
                      "get",
                      "vehicle_id",
                    ],
                    2,
                    4,
                  ],
                  16,
                ],
              ],
            ],
            360,
          ],
          0,
          "#e31a1c",
          60,
          "#ff7f00",
          120,
          "#ffff33",
          180,
          "#33a02c",
          240,
          "#1f78b4",
          300,
          "#6a3d9a",
          359,
          "#e31a1c",
        ],
        "line-opacity": 0.8,
        "line-width": [
          "interpolate",
          [
            "linear",
          ],
          [
            "zoom",
          ],
          8,
          1,
          12,
          2,
          16,
          4,
        ],
      },
      "source": "vehicle_tracks",
      "source-layer": "vehicle_tracks",
      "type": "line",
    },
